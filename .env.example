# ============================================================
# Variables de Entorno de Ejemplo para Mini CRM
# Copia este archivo como .env para desarrollo local o producción
# ============================================================

# Clave secreta de Django (en producción genera una clave aleatoria y segura)
SECRET_KEY=cambia-esta-clave

# Modo depuración (True en desarrollo, False en producción)
DEBUG=True

# Hosts permitidos separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],web

# Directorio de base de datos SQLite (opcional, útil para Docker o rutas personalizadas)
DJANGO_DB_DIR=/app/data
